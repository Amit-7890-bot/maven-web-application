pipeline{

agent any

tools {
  maven 'maven-test'
}
stages{
 //this stage for checkout
 stage('checkout'){
 steps{
 sendSlackNotifation('STARTED')
 git branch: 'test', url: 'https://github.com/Amit-7890-bot/maven-web-application.git'
 }
 }
 
 //build
 stage('build'){
 steps{
 sendSlackNotifation('MAVEN_BUILD')
 sh "mvn clean package"
 } 
 }
 //sonar
 stage('sonar'){
 steps{
sendSlackNotifation('SONAR_SCANNING')
withSonarQubeEnv('SonarQube'){
 sh "mvn clean sonar:sonar"
 }
 } 
 }
 //nexus
 stage('artifact'){
 steps{
sendSlackNotifation('NEXUS_ARTIFACT')
 sh "mvn clean deploy"
 }
 }
 //tomcat
 stage('deploy'){
 steps{
 sendSlackNotifation('TOMCAT_DEPLOYMENT')
 sshagent(credentials: ['ec2-user']){
 sh "scp -o StrictHostKeyChecking=no target/maven-web-application.war ec2-user@34.228.23.0:/opt/apache-tomcat-9.0.120/webapps"
 }
 }
 }
 }//stages closing
 post {
  success {
    sendSlackNotifation(currentBuild.result)
  }
  failure {
    sendSlackNotifation(currentBuild.result)
  }
}
}//pipeline close

//send notificatin
def sendSlackNotifation(String buildStatus = 'STARTED') {
  // build status of null means successful
  buildStatus =  buildStatus ?: 'SUCCESSFUL'

  // Default values
  def colorName = 'RED'
  def colorCode = '#FF0000'
  def subject = "${buildStatus}: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]'"
  def summary = "${subject} (${env.BUILD_URL})"

  // Override default values based on build status
  if (buildStatus == 'STARTED') {
    color = 'YELLOW'
    colorCode = '#FFFF00'
  } else if (buildStatus == 'SUCCESSFUL') {
    color = 'GREEN'
    colorCode = '#00FF00'
  } else {
    color = 'RED'
    colorCode = '#FF0000'
  }

  // Send notifications
  slackSend (color: colorCode, message: summary, channel: 'new-channel')
}
