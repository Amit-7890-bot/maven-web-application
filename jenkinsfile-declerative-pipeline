pipeline{

agent any

tools {
  maven 'maven-test'
}
stages{
 //this stage for checkout
 stage('checkout'){
 steps{
 git branch: 'test', url: 'https://github.com/Amit-7890-bot/maven-web-application.git'
 }
 }
 
 //build
 stage('build'){
 steps{
 sh "mvn clean package"
 } 
 }
 //sonar
 stage('sonar'){
 steps{
withSonarQubeEnv('SonarQube'){
 sh "mvn clean sonar:sonar"
 }
 } 
 }
 //nexus
 stage('artifact'){
 steps{
 sh "mvn clean deploy"
 }
 }
 //tomcat
 stage('deploy'){
 steps{
 sshagent(credentials: ['ec2-user']){
 sh "scp -o StrictHostKeyChecking=no target/maven-web-application.war ec2-user@34.228.23.0:/opt/apache-tomcat-9.0.120/webapps"
 }
 }
 }
}//stages closing
}
